[Unit]
Description=Veloura Music Player Flask Backend
After=network.target

[Service]
User=root
WorkingDirectory=/opt/veloura/backend
ExecStart=/opt/veloura/backend/venv/bin/gunicorn server:app --bind 0.0.0.0:5000 --workers 3 --timeout 120
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
